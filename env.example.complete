# =============================================================================
# COMPLETE ENVIRONMENT CONFIGURATION EXAMPLE
# =============================================================================
# This file shows how to configure both development and production settings
# in the same .env file. The application automatically chooses which settings
# to use based on the NODE_ENV variable.

# =============================================================================
# ENVIRONMENT SELECTION
# =============================================================================
# Change this to switch between environments:
# - development: Uses DEV_* variables
# - staging: Uses STAGING_* variables  
# - production: Uses PROD_* variables
NODE_ENV=development

# =============================================================================
# DEVELOPMENT ENVIRONMENT SETTINGS
# =============================================================================
# These are used when NODE_ENV=development

# Development Server Configuration
DEV_PORT=5002
DEV_CORS_ORIGIN=*
DEV_UPLOADS_DIR=uploads
DEV_OUTPUT_DIR=output
DEV_TEMP_DIR=temp
DEV_LOGS_DIR=logs

# Development API Keys (use test/development keys)
DEV_OPENAI_API_KEY=sk-dev-your-development-openai-key-here
DEV_MONDAY_API_KEY=your-dev-monday-api-key-here
DEV_MONDAY_BOARD_ID=1234567890

# =============================================================================
# STAGING ENVIRONMENT SETTINGS
# =============================================================================
# These are used when NODE_ENV=staging

# Staging Server Configuration
STAGING_PORT=5002
STAGING_CORS_ORIGIN=https://staging.yourdomain.com
STAGING_UPLOADS_DIR=/var/staging/uploads
STAGING_OUTPUT_DIR=/var/staging/output
STAGING_TEMP_DIR=/tmp
STAGING_LOGS_DIR=/var/log/staging

# Staging API Keys
STAGING_OPENAI_API_KEY=sk-staging-your-staging-openai-key-here
STAGING_MONDAY_API_KEY=your-staging-monday-api-key-here
STAGING_MONDAY_BOARD_ID=0987654321

# =============================================================================
# PRODUCTION ENVIRONMENT SETTINGS
# =============================================================================
# These are used when NODE_ENV=production

# Production Server Configuration
PROD_PORT=5002
PROD_CORS_ORIGIN=https://yourdomain.com
PROD_UPLOADS_DIR=/var/app/uploads
PROD_OUTPUT_DIR=/var/app/output
PROD_TEMP_DIR=/tmp
PROD_LOGS_DIR=/var/log/your-app

# Production API Keys (use real production keys)
PROD_OPENAI_API_KEY=sk-prod-your-production-openai-key-here
PROD_MONDAY_API_KEY=your-prod-monday-api-key-here
PROD_MONDAY_BOARD_ID=1122334455

# =============================================================================
# SHARED SETTINGS (used across all environments)
# =============================================================================
# These settings are the same regardless of environment

# Python Configuration
PYTHON_PATH=python

# File Upload Limits (in bytes)
MAX_FILE_SIZE=52428800  # 50MB
MAX_FILES=10

# Processing Timeouts (in milliseconds)
PYTHON_TIMEOUT=300000   # 5 minutes
PYTHON_MAX_BUFFER=10485760  # 10MB

# Logging Configuration
LOG_LEVEL=info  # debug, info, warn, error

# =============================================================================
# HOW IT WORKS
# =============================================================================
# 
# The application automatically selects which variables to use based on NODE_ENV:
#
# When NODE_ENV=development:
#   - Uses DEV_PORT, DEV_CORS_ORIGIN, DEV_UPLOADS_DIR, etc.
#   - Falls back to generic PORT, CORS_ORIGIN, UPLOADS_DIR if DEV_* not found
#
# When NODE_ENV=staging:
#   - Uses STAGING_PORT, STAGING_CORS_ORIGIN, STAGING_UPLOADS_DIR, etc.
#   - Falls back to generic variables if STAGING_* not found
#
# When NODE_ENV=production:
#   - Uses PROD_PORT, PROD_CORS_ORIGIN, PROD_UPLOADS_DIR, etc.
#   - Falls back to generic variables if PROD_* not found
#
# =============================================================================
# EXAMPLE USAGE
# =============================================================================
#
# 1. For Development:
#    NODE_ENV=development
#    # Uses: DEV_PORT=5002, DEV_UPLOADS_DIR=uploads, etc.
#
# 2. For Production:
#    NODE_ENV=production  
#    # Uses: PROD_PORT=5002, PROD_UPLOADS_DIR=/var/app/uploads, etc.
#
# 3. To switch environments, just change NODE_ENV:
#    export NODE_ENV=production
#    npm start
#
# =============================================================================
