# Environment Configuration Example
# Copy this file to .env and update the values for your deployment

# =============================================================================
# ENVIRONMENT SELECTION
# =============================================================================
# Set this to determine which environment configuration to use
# Options: development, staging, production
NODE_ENV=development

# =============================================================================
# DEVELOPMENT ENVIRONMENT SETTINGS
# =============================================================================
# These settings are used when NODE_ENV=development

# Development Server Configuration
DEV_PORT=5002
DEV_CORS_ORIGIN=*
DEV_UPLOADS_DIR=uploads
DEV_OUTPUT_DIR=output
DEV_TEMP_DIR=temp
DEV_LOGS_DIR=logs

# Development API Keys (use test/development keys)
DEV_OPENAI_API_KEY=your_dev_openai_api_key_here
DEV_MONDAY_API_KEY=your_dev_monday_api_key_here
DEV_MONDAY_BOARD_ID=your_dev_monday_board_id_here

# =============================================================================
# STAGING ENVIRONMENT SETTINGS
# =============================================================================
# These settings are used when NODE_ENV=staging

# Staging Server Configuration
STAGING_PORT=5002
STAGING_CORS_ORIGIN=https://staging.yourdomain.com
STAGING_UPLOADS_DIR=/var/staging/uploads
STAGING_OUTPUT_DIR=/var/staging/output
STAGING_TEMP_DIR=/tmp
STAGING_LOGS_DIR=/var/log/staging

# Staging API Keys
STAGING_OPENAI_API_KEY=your_staging_openai_api_key_here
STAGING_MONDAY_API_KEY=your_staging_monday_api_key_here
STAGING_MONDAY_BOARD_ID=your_staging_monday_board_id_here

# =============================================================================
# PRODUCTION ENVIRONMENT SETTINGS
# =============================================================================
# These settings are used when NODE_ENV=production

# Production Server Configuration
PROD_PORT=5002
PROD_CORS_ORIGIN=https://yourdomain.com
PROD_UPLOADS_DIR=/var/app/uploads
PROD_OUTPUT_DIR=/var/app/output
PROD_TEMP_DIR=/tmp
PROD_LOGS_DIR=/var/log/your-app

# Production API Keys
PROD_OPENAI_API_KEY=your_prod_openai_api_key_here
PROD_MONDAY_API_KEY=your_prod_monday_api_key_here
PROD_MONDAY_BOARD_ID=your_prod_monday_board_id_here

# =============================================================================
# SHARED SETTINGS (used across all environments)
# =============================================================================
# These settings are the same regardless of environment

# Python Configuration
PYTHON_PATH=python

# File Upload Limits (in bytes)
MAX_FILE_SIZE=52428800  # 50MB
MAX_FILES=10

# Processing Timeouts (in milliseconds)
PYTHON_TIMEOUT=300000   # 5 minutes
PYTHON_MAX_BUFFER=10485760  # 10MB

# Logging Configuration
LOG_LEVEL=info  # debug, info, warn, error
