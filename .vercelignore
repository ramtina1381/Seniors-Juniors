# Vercel ignore file
# Files and directories to exclude from Vercel deployment

# Development files
.env
.env.local
.env.development
.env.test
.env.production

# Logs
*.log
logs/
server_errors.log
equipment_processor.log

# Temporary files
temp/
tmp/
uploads/
output/

# Node modules (will be installed by Vercel)
node_modules/
server/node_modules/
client/node_modules/

# Build artifacts
client/build/
dist/

# Git
.git/
.gitignore

# Documentation
*.md
docs/

# Test files
test/
tests/
__tests__/
*.test.js
*.spec.js

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Python cache
__pycache__/
*.pyc
*.pyo

# Docker files (not needed for Vercel)
Dockerfile
docker-compose.yml
.dockerignore

# Deployment scripts
deploy.sh
deploy-*.sh
